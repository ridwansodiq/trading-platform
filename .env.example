# Copy to .env (and backend/.env) before running the API.
# Every variable is validated at startup by backend/src/infrastructure/config/env.ts —
# a missing or malformed value fails immediately rather than surfacing mid-request.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fusion:fusion@localhost:5435/fusion?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# The single browser origin allowed to send credentialed requests.
FRONTEND_ORIGIN="http://localhost:5173"

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME="fusion_session"
SESSION_TTL_HOURS=12
# How often expired session rows are deleted. Nothing else prunes them.
SESSION_SWEEP_MINUTES=15

# ── Realtime ────────────────────────────────────────────────────────────────
# Cap on concurrent SSE subscribers; each holds an open socket and a timer.
SSE_MAX_CLIENTS=500
# How often a live stream re-checks that its session is still valid, so a
# revoked session stops receiving trade data.
SSE_SESSION_RECHECK_SECONDS=60

# ── Documentation ───────────────────────────────────────────────────────────
# Swagger UI at /api/docs. Defaults to on outside production, off in it —
# set explicitly to override either way.
# ENABLE_API_DOCS=false
