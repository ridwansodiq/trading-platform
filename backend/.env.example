# Copy to backend/.env before running the API:
#
#   cp backend/.env.example backend/.env
#
# It lives beside the backend because that is where it is read from: every npm
# script runs with `-w backend`, and both dotenv and the Prisma CLI resolve
# `.env` relative to the working directory. A copy at the repository root is
# read by nothing.
#
# Every variable is validated at startup by backend/src/infrastructure/config/env.ts —
# a missing or malformed value fails immediately rather than surfacing mid-request.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fusion:fusion@localhost:5435/fusion?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# The single browser origin allowed to send credentialed requests.
FRONTEND_ORIGIN="http://localhost:5173"

# ── Sessions ────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME="fusion_session"
SESSION_TTL_HOURS=12
# How often expired session rows are deleted. Nothing else prunes them.
SESSION_SWEEP_MINUTES=15
# Whether the session cookie is marked `Secure`. Defaults to on in production,
# the only correct setting behind TLS. The container demo sets it to false
# because it is reached over plain http://localhost, where some browsers drop
# a Secure cookie and login then fails silently.
# SESSION_COOKIE_SECURE=false

# ── Realtime ────────────────────────────────────────────────────────────────
# Cap on concurrent SSE subscribers; each holds an open socket and a timer.
SSE_MAX_CLIENTS=500
# How often a live stream re-checks that its session is still valid, so a
# revoked session stops receiving trade data.
SSE_SESSION_RECHECK_SECONDS=60

# ── Static frontend ─────────────────────────────────────────────────────────
# Absolute path to a built SPA for the API to serve. Leave unset in
# development: Vite serves the app on :5173 and proxies /api here. The
# container image sets it, so the whole demo is one origin.
# SPA_DIR=/repo/frontend/dist

# ── Documentation ───────────────────────────────────────────────────────────
# Swagger UI at /api/docs. Defaults to on outside production, off in it —
# set explicitly to override either way.
# ENABLE_API_DOCS=false
