# The image installs its own dependencies. A host tree copied in here would
# ship the wrong platform's Prisma query engine and mask a broken install —
# which is exactly how `backend/Dockerfile` came to depend on a directory that
# `npm ci` never creates.
**/node_modules
**/dist
**/*.tsbuildinfo
**/coverage

# Secrets must never enter the build context.
**/.env
**/.env.*
!**/.env.example

.git
.github
.DS_Store
.boundary-probe-*
